# =============================================================================
# SiliconIA Environment Variables
# =============================================================================

# AUTENTICACIÓN CODEX CLI (RECOMENDADO):
# Si ya iniciaste sesión con Codex CLI en Windows (`codex auth login`),
# NO necesitas poner ninguna API Key aquí.
# Tus credenciales en C:\Users\carlo\.codex\ se montan automáticamente en Docker.

# MÉTODO ALTERNATIVO: API Key directa (opcional si NO usas Codex CLI login)
# OPENAI_API_KEY=sk-...
# CODEX_API_KEY=sk-...

# Alternativa: Anthropic Claude (opcional si se cambia el proveedor)
# ANTHROPIC_API_KEY=sk-ant-...

# X11 Display para OpenROAD GUI en WSL2 / VcXsrv (opcional, auto-detectado si existe)
# DISPLAY=:0

