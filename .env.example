# Path to Claude Code session files inside the container.
# The ~/.claude directory on your host is mounted as /dot-claude in the container.
#
# Default: /dot-claude/projects/-root
#   → use this if you run Claude Code from your home directory (~/)
#
# Other examples:
#   /dot-claude/projects/-home-user-myproject  → ~/myproject
#   /dot-claude/projects/-Users-john-work      → /Users/john/work (macOS)
CLAUDE_JSONL_DIR=/dot-claude/projects/-root

# ── SiliconIA source (default data source) ──────────────────────────────────
# Directory containing SiliconIA run folders (<run_id>/siliconia_events.jsonl,
# <run_id>/.coresmith/pipeline_events.jsonl, current_run.json).
# Default: ./SiliconIA/silicon-runs (relative to the app's working directory)
# SILICONIA_RUNS_DIR=C:\Users\carlo\pixel-agents-main\SiliconIA\silicon-runs

# Default stream when the page has no ?source= param: "siliconia" | "claude"
# NEXT_PUBLIC_PIXEL_SOURCE=siliconia
